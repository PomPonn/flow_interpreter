# literal - literal #
2 eq 3;

# id - literal #
num equals 2;

# id - id #
num1 gt num2;

# expr - id #
(3 + 2) * ampl;

# simple expr - simple expr #
(4 pow 3) alt (6 * magnitude);

# T6 operator chaining 1 #
4 - 2 + 6 pow 4;

# operator chaining 2 #
165 = 2 + (x ^ y) - 18 * w;

# operator chaining 3 #
var = 4 - 2 * 5 / 6 + 1;

# (function call) #
some_result is mult(4, 9);

# function call with extended chaining #
(my_func(4, (4 * 2) - my_var) as float) / 12 * ring;

# type assignment #
x : float = 5.123;