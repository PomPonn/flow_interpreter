io = import(":std.io");

pow2_fn_1 = a -> a * a;

pow2_fn_2 = [a] -> a * a;

avg_fn = [a, b, c] -> {
    div = [] -> 3;

    # last expression is returned #
    (a + b + c) / div();
};

x = pow2_fn_1(2);
y = pow2_fn_2(2);
z = avg_fn(2, 3, 4);

hello_fn = [] -> {
    io.put("Hello!\nx:");
    io.put(x);

    io.put("y:");
    io.put(y);

    io.put("z:");
    io.put(z);
};

hello_fn();