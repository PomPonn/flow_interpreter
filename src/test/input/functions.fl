# function type called like a func #

# first arg is a return type #
fun1 : func(int, int, float) = () -> {

}

# function without braces #
fun3 : func(int, int, int) = (a, b) -> a + b;
# or shortened without typing #
fun3 = (a, b) -> a + b;

# when there is only one param we can omit parens #
fun2 = b -> b ^ 2;